/*
 * Assignment 3 - Dual-core vector addition (Core 1 / worker)
 * UniCa - Advanced Embedded Systems (AES)
 *
 * Core 1 computes C[i] = A[i] + B[i] for i in [ARRAY_SIZE/2, ARRAY_SIZE).
 * Waits for start from Core 0, then sets done1 when finished.
 */

#include "xparameters.h"
#include "xil_cache.h"
#include "shared.h"
#include "xil_io.h"

int main(void)
{
    int j;

    Xil_ICacheDisable();
    Xil_DCacheDisable();

    SHARED->ready1 = FLAG_RESET;
    SHARED->done1  = FLAG_RESET;
    SHARED->ready1 = FLAG_SET;

    while (SHARED->start != FLAG_SET)
        ;

    for (j = ARRAY_SIZE / 2; j < ARRAY_SIZE; j++)
        SHARED->C[j] = SHARED->A[j] + SHARED->B[j];

    SHARED->done1 = FLAG_SET;

    for (;;)
        ;
    return 0;
}
