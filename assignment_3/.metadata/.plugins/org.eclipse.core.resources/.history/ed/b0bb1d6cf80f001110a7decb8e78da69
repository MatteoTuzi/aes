/*
 * Lab 4 – Parallel Vector Add: SERIAL baseline vs PARALLEL (dual-core).
 * Measures execution time via ARM Global Timer; supports varying ARRAY_SIZE.
 */
#include "xparameters.h"
#include "xil_cache.h"
#include "xil_printf.h"
#include "xtime_l.h"
#include "shared.h"
#include "xil_io.h"

u32 t_start, t_end;

static inline u32 read_global_timer(void)
{
    return Xil_In32(GLOBAL_TMR_BASEADDR + GTIMER_COUNTER_LOWER_OFFSET);
}

/* Serial vector add: c[i] = a[i] + b[i] for i = 0..n-1.
 * Used as baseline; measure execution time for different n (ARRAY_SIZE). */
void vec_add_serial(u32 * restrict c, const u32 * restrict a, const u32 * restrict b, int n)
{
    for (int i = 0; i < n; ++i) {
        c[i] = a[i] + b[i];
    }
}

int main(void)
{
    int i;
    static u32 C_serial[ARRAY_SIZE];  /* reference output for validation */

    Xil_ICacheDisable();
    Xil_DCacheDisable();

    while (Xil_In32(XPAR_AXI_GPIO_2_BASEADDR) == 0);  /* wait for start button */

    xil_printf("=== LAB 4 === Parallel Vector Add (SERIAL vs PARALLEL)\r\n");
    xil_printf("MASTER: ARRAY_SIZE=%d\r\n", ARRAY_SIZE);

    /* Init shared flags */
    SHARED->start   = FLAG_RESET;
    SHARED->done0   = FLAG_RESET;
    SHARED->done1   = FLAG_RESET;
    SHARED->ready1  = FLAG_RESET;

    /* Init vectors in shared memory */
    for (i = 0; i < ARRAY_SIZE; ++i) {
        SHARED->A[i] = i;
        SHARED->B[i] = 2 * i;
        SHARED->C[i] = 0;
    }

    /* ---------- SERIAL EXECUTION (baseline) ---------- */
    xil_printf("Core 0: Starting SERIAL version...\r\n");
    t_start = read_global_timer();
    vec_add_serial(C_serial, (const u32 *)SHARED->A, (const u32 *)SHARED->B, ARRAY_SIZE);
    t_end = read_global_timer();
    u32 serial_cycles = t_end - t_start;
    xil_printf("Core 0: Serial done, cycles = %lu\r\n", (unsigned long)serial_cycles);

    /* Clear C before parallel run */
    for (i = 0; i < ARRAY_SIZE; ++i)
        SHARED->C[i] = 0;

    /* ---------- PARALLEL EXECUTION ---------- */
    xil_printf("Core 0: Waiting for worker, then PARALLEL...\r\n");
    while (SHARED->ready1 != FLAG_SET);

    t_start = read_global_timer();
    SHARED->start = FLAG_SET;

    /* Core 0: first half */
    for (i = 0; i < ARRAY_SIZE / 2; ++i)
        SHARED->C[i] = SHARED->A[i] + SHARED->B[i];
    SHARED->done0 = FLAG_SET;

    while (SHARED->done1 != FLAG_SET);
    t_end = read_global_timer();
    u32 parallel_cycles = t_end - t_start;

    /* ---------- TIMING SUMMARY ---------- */
    if (parallel_cycles == 0) parallel_cycles = 1;
    u32 speedup_x100 = (serial_cycles * 100) / parallel_cycles;
    xil_printf("\r\n=== TIMING SUMMARY ===\r\n");
    xil_printf("Serial   cycles = %lu\r\n", (unsigned long)serial_cycles);
    xil_printf("Parallel cycles = %lu\r\n", (unsigned long)parallel_cycles);
    xil_printf("Speedup  = %lu.%02lu x\r\n", speedup_x100 / 100, speedup_x100 % 100);

    /* ---------- VALIDATION ---------- */
    int errors = 0;
    for (i = 0; i < ARRAY_SIZE; ++i) {
        if (SHARED->C[i] != C_serial[i]) {
            errors++;
            if (errors < 10)
                xil_printf("Mismatch at %d: got %lu, expected %lu\r\n",
                           i, (unsigned long)SHARED->C[i], (unsigned long)C_serial[i]);
        }
    }
    xil_printf("Errors = %d\r\n", errors);

    while (1) { }
    return 0;
}
